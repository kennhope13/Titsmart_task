generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                 @unique @db.VarChar(80)
  name                   String                 @db.VarChar(255)
  location               String                 @default("") @db.VarChar(255)
  status                 String                 @default("active") @db.VarChar(255)
  manager_id             String?                @db.Uuid
  manager_name           String?                @db.VarChar(255)
  start_date             DateTime?              @db.Date
  end_date               DateTime?              @db.Date
  active_teams           Int                    @default(0)
  progress_percent       Decimal                @default(0) @db.Decimal(5, 2)
  total_tasks            Int                    @default(0)
  completed_tasks        Int                    @default(0)
  issue_tasks_count      Int                    @default(0)
  notes                  String?
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  client                 String?                @db.VarChar(255)
  contract_value         Decimal?               @db.Decimal
  activity_logs          ActivityLog[]
  document_tracks        DocumentTrack[]
  field_logs             FieldLog[]
  inventory_transactions InventoryTransaction[]
  issues                 Issue[]
  labor_payrolls         LaborPayroll[]
  materials              Material[]
  member_assignments     ProjectMember[]

  @@index([status])
  @@map("projects")
}

model ProjectMember {
  user_id    String   @db.Uuid
  project_id String   @db.Uuid
  role       String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([user_id, project_id])
  @@index([project_id])
  @@map("project_members")
}

model Task {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id             String?          @db.Uuid
  stt                    String?          @db.VarChar(50)
  code                   String           @unique @db.VarChar(100)
  name                   String
  volume                 Decimal          @default(0) @db.Decimal(18, 4)
  unit                   String           @default("") @db.VarChar(50)
  progress               Decimal          @default(0) @db.Decimal(7, 4)
  status                 String           @default("not_started") @db.VarChar(255)
  priority               String           @default("medium") @db.VarChar(255)
  purchase_status        String           @default("") @db.VarChar(255)
  constr_status          String           @default("") @db.VarChar(255)
  issue_summary          String?
  issue_status_text      String?          @db.VarChar(255)
  is_done                Boolean          @default(false)
  is_section_header      Boolean          @default(false)
  section_name           String?
  parent_id              String?          @db.Uuid
  notes                  String?
  assigned_engineer_id   String?          @db.Uuid
  due_date               DateTime?        @db.Date
  source_row             Json             @default("{}")
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  project_code           String?          @db.VarChar(255)
  project_name           String?          @db.VarChar(255)
  assigned_engineer_name String?          @db.VarChar(255)
  issue                  String?
  issue_status           String?          @db.VarChar(255)
  assigner_id            String?          @db.Uuid
  reviewer_id            String?          @db.Uuid
  issues                 Issue[]
  materials              Material[]
  progress_updates       ProgressUpdate[]
  task_assignments       TaskAssignment[]
  parent                 Task?            @relation("TaskToTask", fields: [parent_id], references: [id], onDelete: Cascade)
  sub_tasks              Task[]           @relation("TaskToTask")

  @@index([project_id])
  @@index([status])
  @@index([assigned_engineer_id])
  @@map("tasks")
}

model TaskAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id     String   @db.Uuid
  user_id     String   @db.Uuid
  assigned_by String?  @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  notes       String?
  task        Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@map("task_assignments")
}

model Material {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id             String?                @db.Uuid
  task_id                String?                @db.Uuid
  stt                    Int?
  code                   String                 @unique @db.VarChar(100)
  name                   String
  english_name           String?
  volume                 Decimal                @default(0) @db.Decimal(18, 4)
  unit                   String                 @default("") @db.VarChar(50)
  unit_price             Decimal                @default(0) @db.Decimal(18, 2)
  status                 String                 @default("") @db.VarChar(255)
  construction_status    String?                @db.VarChar(255)
  supplier               String?                @db.VarChar(255)
  initial_stock          Decimal                @default(0) @db.Decimal(18, 4)
  current_stock          Decimal                @default(0) @db.Decimal(18, 4)
  total_import           Decimal                @default(0) @db.Decimal(18, 4)
  total_export           Decimal                @default(0) @db.Decimal(18, 4)
  category               String?                @db.VarChar(255)
  specs                  String?
  notes                  String?
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  project_code           String?                @db.VarChar(255)
  project_name           String?                @db.VarChar(255)
  constr_status          String?                @db.VarChar(255)
  inventory_transactions InventoryTransaction[]
  project                Project?               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task                   Task?                  @relation(fields: [task_id], references: [id])

  @@index([project_id])
  @@index([task_id])
  @@map("materials")
}

model InventoryTransaction {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  material_id       String                     @db.Uuid
  project_id        String?                    @db.Uuid
  type              inventory_transaction_type
  transaction_date  DateTime                   @db.Date
  quantity          Decimal                    @db.Decimal(18, 4)
  source_or_project String                     @default("") @db.VarChar(255)
  receiver_name     String?                    @db.VarChar(255)
  notes             String?
  created_by        String?                    @db.Uuid
  created_at        DateTime                   @default(now()) @db.Timestamptz(6)
  material          Material                   @relation(fields: [material_id], references: [id], onDelete: Cascade)
  project           Project?                   @relation(fields: [project_id], references: [id])

  @@index([material_id])
  @@index([project_id])
  @@map("inventory_transactions")
}

model ProgressUpdate {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id     String      @db.Uuid
  user_id     String?     @db.Uuid
  progress    Decimal     @db.Decimal(7, 4)
  status      task_status
  note        String?
  recorded_at DateTime    @default(now()) @db.Timestamptz(6)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  task        Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("progress_updates")
}

model Issue {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String         @db.Uuid
  task_id            String?        @db.Uuid
  incident_code      String         @unique @db.VarChar(100)
  title              String
  location           String         @default("")
  reported_by_id     String?        @db.Uuid
  reported_by_name   String?        @db.VarChar(255)
  reported_at        DateTime       @default(now()) @db.Timestamptz(6)
  description        String         @default("")
  photo_url          String?
  status             String         @default("open") @db.VarChar(255)
  priority           String         @default("standard") @db.VarChar(255)
  assigned_to_id     String?        @db.Uuid
  assigned_to_name   String?        @db.VarChar(255)
  manager_directives String?
  resolved_at        DateTime?      @db.Timestamptz(6)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @db.Timestamptz(6)
  comments           IssueComment[]
  project            Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task               Task?          @relation(fields: [task_id], references: [id])

  @@index([project_id])
  @@index([task_id])
  @@index([status])
  @@map("issues")
}

model IssueComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id    String   @db.Uuid
  author_id   String?  @db.Uuid
  author_name String?  @db.VarChar(255)
  message     String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  issue       Issue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id])
  @@map("issue_comments")
}

model Attachment {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type      attachment_owner_type
  owner_id        String                @db.Uuid
  file_name       String                @db.VarChar(255)
  file_url        String
  mime_type       String?               @db.VarChar(120)
  file_size_bytes BigInt?
  uploaded_by     String?               @db.Uuid
  uploaded_at     DateTime              @default(now()) @db.Timestamptz(6)

  @@index([owner_type, owner_id])
  @@map("attachments")
}

model Notification {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?           @db.Uuid
  title      String            @db.VarChar(255)
  message    String
  type       notification_type @default(system)
  icon       String?           @db.VarChar(80)
  is_read    Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

model ActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?  @db.Uuid
  user_name    String   @db.VarChar(255)
  action       String
  project_id   String?  @db.Uuid
  project_name String?  @db.VarChar(255)
  icon         String?  @db.VarChar(80)
  badge_bg     String?  @db.VarChar(80)
  icon_color   String?  @db.VarChar(80)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  project      Project? @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("activity_logs")
}

model LaborPayroll {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String   @db.Uuid
  stt               String?  @db.VarChar(50)
  payroll_date      DateTime @db.Date
  content           String
  description       String   @default("")
  worker_name       String?  @db.VarChar(255)
  unit              String   @default("") @db.VarChar(50)
  quantity          Decimal  @default(0) @db.Decimal(18, 4)
  unit_price        Decimal  @default(0) @db.Decimal(18, 2)
  total_amount      Decimal  @default(0) @db.Decimal(18, 2)
  bank_account      String   @default("") @db.VarChar(255)
  bank_info         String?
  id_card_front_url String?
  id_card_back_url  String?
  payment_status    String   @default("") @db.VarChar(255)
  notes             String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  project_code      String?  @db.VarChar(255)
  project_name      String?  @db.VarChar(255)
  project           Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("labor_payrolls")
}

model DocumentTrack {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String?   @db.Uuid
  stt            String?   @db.VarChar(50)
  contract_no    String    @db.VarChar(120)
  contract_name  String
  company        String    @default("") @db.VarChar(255)
  receiver_name  String    @default("") @db.VarChar(255)
  phone          String    @default("") @db.VarChar(50)
  address        String    @default("")
  send_date      DateTime  @db.Date
  receive_date   DateTime? @db.Date
  doc_status     String    @default("") @db.VarChar(255)
  side           String?   @db.VarChar(255)
  contract_value Decimal   @default(0) @db.Decimal(18, 2)
  prepay_percent Decimal   @default(0) @db.Decimal(5, 2)
  prepay_amount  Decimal   @default(0) @db.Decimal(18, 2)
  payment_status String    @default("") @db.VarChar(255)
  is_completed   Boolean   @default(false)
  notes          String?
  doc_type       String?   @default("Giao") @db.VarChar(50)
  file_urls      String[]  @default([])
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  project_code   String?   @db.VarChar(255)
  project_name   String?   @db.VarChar(255)
  project        Project?  @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("document_tracks")
}

model FieldLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String   @db.Uuid
  note         String?
  images       Json     @default("[]")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  project_code String?  @db.VarChar(255)
  project_name String?  @db.VarChar(255)
  project      Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("field_logs")
}

model AttendanceLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String
  user_name       String    @default("")
  project_id      String?
  project_name    String?
  check_in_time   DateTime  @default(now()) @db.Timestamptz(6)
  check_out_time  DateTime? @db.Timestamptz(6)
  check_in_image  String?
  check_out_image String?
  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([check_in_time], map: "idx_attendance_checkin")
  @@index([project_id], map: "idx_attendance_project")
  @@index([user_id], map: "idx_attendance_user")
  @@map("attendance_logs")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model engineers {
  id               String?
  code             String?
  name             String?
  title            String?
  avatar           String?
  phone            BigInt?
  email            String?
  created_at       DateTime? @db.Timestamptz(6)
  role             String?
  username         String?
  password         String?
  is_locked        Boolean?
  project_codes    Json?
  managed_projects Json?
  member_projects  Json?

  @@ignore
}

model expenses {
  id            String   @id(map: "project_expenses_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String?  @db.Uuid
  stt           String?  @db.VarChar(50)
  expense_date  DateTime @db.Date
  content       String
  description   String   @default("")
  unit          String   @default("") @db.VarChar(50)
  quantity      Decimal  @default(0) @db.Decimal(18, 4)
  unit_price    Decimal  @default(0) @db.Decimal(18, 2)
  tax_amount    Decimal  @default(0) @db.Decimal(18, 2)
  total_amount  Decimal  @default(0) @db.Decimal(18, 2)
  income_amount Decimal  @default(0) @db.Decimal(18, 2)
  balance_fund  Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?
  invoice_url   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([project_id], map: "project_expenses_project_id_idx")
}

model material_plans {
  id                   String           @id(map: "project_material_plans_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String?          @db.Uuid
  stt                  String?          @db.VarChar(50)
  job_content          String
  unit                 String           @default("") @db.VarChar(50)
  contract_volume      Decimal          @default(0) @db.Decimal(18, 4)
  tech_spec_model      String?
  tech_spec_origin     String?
  tech_spec_status     String?          @db.VarChar(255)
  progress_status      String?          @db.VarChar(255)
  ordered_volume       Decimal          @default(0) @db.Decimal(18, 4)
  ordered_status       String?          @db.VarChar(255)
  expected_date        DateTime?        @db.Date
  issue_content        String?
  issue_status         String?
  doc_co               Boolean          @default(false)
  doc_cq               Boolean          @default(false)
  doc_fire_inspection  Boolean          @default(false)
  doc_stamp            Boolean          @default(false)
  dispatch_to_site     Boolean          @default(false)
  dispatch_date        DateTime?        @db.Date
  notes                String?
  parent_id            String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  material_plans       material_plans?  @relation("material_plansTomaterial_plans", fields: [parent_id], references: [id], map: "project_material_plans_parent_id_fkey")
  other_material_plans material_plans[] @relation("material_plansTomaterial_plans")

  @@index([project_id], map: "project_material_plans_project_id_idx")
}

model purchasing_plans {
  id                     String             @id(map: "project_purchasing_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id             String?            @db.Uuid
  stt                    String?            @db.VarChar(50)
  content                String
  unit                   String             @default("") @db.VarChar(50)
  volume_contract        Decimal            @default(0) @db.Decimal(18, 4)
  volume_order           Decimal            @default(0) @db.Decimal(18, 4)
  unit_price             Decimal            @default(0) @db.Decimal(18, 2)
  vat_rate               Decimal            @default(0) @db.Decimal(5, 2)
  vat_amount             Decimal            @default(0) @db.Decimal(18, 2)
  total_amount           Decimal            @default(0) @db.Decimal(18, 2)
  prepay_percent         Decimal            @default(0) @db.Decimal(5, 2)
  prepay_amount          Decimal            @default(0) @db.Decimal(18, 2)
  remaining_amount       Decimal            @default(0) @db.Decimal(18, 2)
  order_status           String             @default("") @db.VarChar(255)
  contract_status        String             @default("") @db.VarChar(255)
  payment_date           DateTime?          @db.Date
  invoice_status         String?            @db.VarChar(255)
  notes                  String?
  parent_id              String?            @db.Uuid
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)
  purchasing_plans       purchasing_plans?  @relation("purchasing_plansTopurchasing_plans", fields: [parent_id], references: [id], map: "project_purchasing_parent_id_fkey")
  other_purchasing_plans purchasing_plans[] @relation("purchasing_plansTopurchasing_plans")

  @@index([project_id], map: "project_purchasing_project_id_idx")
}

enum user_role {
  admin
  manager
  procurement
  engineer
  viewer
}

enum account_status {
  active
  locked
  inactive
}

enum project_status {
  active
  completed
  on_hold
}

enum task_status {
  not_started
  in_progress
  review
  done
}

enum task_priority {
  low
  medium
  high
}

enum issue_status {
  open
  processing
  resolved
}

enum issue_priority {
  standard
  warning
  critical
}

enum notification_type {
  task_assigned
  issue_alert
  material_update
  system
}

enum inventory_transaction_type {
  import
  export
}

enum attachment_owner_type {
  task
  issue
  progress_update
  material
  document_track
  expense
  labor_payroll
}
